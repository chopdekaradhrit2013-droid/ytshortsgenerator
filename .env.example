# ====================================================================
# AI SHORTS FACTORY - Environment Configuration Template
# Duplicate this file to .env and configure your local or cloud keys.
# ====================================================================

# FRONTEND SETTINGS (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# SUPABASE POSTGRESQL & AUTH
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# FASTAPI BACKEND SETTINGS
API_V1_STR=/api/v1
PROJECT_NAME="AI Shorts Factory"
DEBUG=True

# REDIS & CELERY WORKER PIPELINE
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# FFMPEG & SYSTEM BINARIES
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MEDIA_STORAGE_DIR=/tmp/shorts_factory_media

# YOUTUBE DATA API V3 (OAUTH 2.0)
# Obtain from Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# AI & SPEECH RECOGNITION SERVICES
# Used by backend workers for transcript transcription and virality detection
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
