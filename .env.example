# ====================================================================
# AI SHORTS FACTORY - Production & Local Environment Configuration
# Duplicate this file to .env and configure your local or cloud keys.
# ====================================================================

# FRONTEND SETTINGS (Next.js 14)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=production

# FASTAPI BACKEND SETTINGS
API_V1_STR=/api/v1
PROJECT_NAME="AI Shorts Factory"
DEBUG=False
PORT=8000
FRONTEND_PORT=3000

# SECURITY & AUTHENTICATION (JWT)
# Generate a strong 64-character secret using: openssl rand -hex 32
JWT_SECRET_KEY=shorts_factory_jwt_secret_key_production_2026_xyz987
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# BILLING & PAYMENT WEBHOOKS (Stripe / Razorpay / Lemonsqueezy HMAC verification)
PAYMENT_WEBHOOK_SECRET=whsec_shorts_factory_production_secret_2026_safe

# DATABASE CONFIGURATION
# Default: High-performance SQLite engine with write-ahead logging (WAL) & automated backups
DATABASE_PATH=backend/shorts_factory.db
# Optional: Supabase cloud PostgreSQL connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# REDIS & CELERY WORKER PIPELINE (Background video processing queues)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# FFMPEG & SYSTEM BINARIES
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MEDIA_STORAGE_DIR=/var/data/shorts_factory/media_storage

# YOUTUBE DATA API V3 & GOOGLE OAUTH 2.0
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Scopes: https://www.googleapis.com/auth/youtube.upload, https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# AI & SPEECH-TO-TEXT SERVICES
# OpenAI Whisper transcription & TTS:
OPENAI_API_KEY=sk-proj-your-openai-api-key
# Anthropic Claude 3.5 Sonnet for AI clip highlight detection & semantic hook scoring:
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Google Gemini 1.5 Pro for content strategy, niche gap analysis & topic clustering:
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
# Stability AI SDXL for AI thumbnail synthesis:
STABILITY_API_KEY=sk-stab-your-stability-api-key

# DEFAULT SUPER ADMIN INITIAL PROVISIONING CREDENTIALS
SUPERADMIN_EMAIL=admin@shortsfactory.io
SUPERADMIN_PASSWORD=SuperAdmin2026!
